  "recommendations": [
    {
      "action": "Free postgres connections: terminate idle-in-transaction sessions and add max_connections headroom",
      "why": "postgres hit its connection limit and refused new clients before its dependents failed",
      "evidence": [
        "evt_000787",
        "evt_000790",
        "evt_000793",
        "evt_000796"
      ],
      "runbook": "psql -c \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE state = 'idle in transaction' AND state_change < now() - interval '30 seconds';\" then confirm db_pool_in_use_pct drops below 80%. Raise max_connections or the PgBouncer pool_size only if usage stays high."
    },
    {
      "action": "Cap per-client pool size in auth-svc and ledger-svc and fail fast with a 2 s acquire timeout",
      "why": "the callers block on pool acquisition, which turns one saturated database into a platform outage",
      "evidence": [
        "evt_000787",
        "evt_000790"
      ],
      "runbook": "Set DB_POOL_MAX=20 and DB_ACQUIRE_TIMEOUT_MS=2000 in each caller's config, then do a rolling restart one replica at a time."
    },
    {
      "action": "Do not roll back or restart ledger-svc, auth-svc, payments-svc, api-gateway: they are victims of postgres",
      "why": "they depend on postgres directly or indirectly, and their failures follow from it",
      "evidence": [
        "evt_000790",
        "evt_000787",
        "evt_000793",
        "evt_000796"
      ],
      "runbook": "Hold changes on ledger-svc, auth-svc, payments-svc, api-gateway. Re-check their error_rate after postgres recovers."
    }
  ],
